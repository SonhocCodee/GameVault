rules_version = '2';

// GameVault — public-read community data, owner-only writes.
// Deploy: Firebase console → Firestore Database → Rules → paste → Publish
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Public profiles (display name, photo, hardware) — write only own doc
    match /users/{uid} {
      allow read: if true;
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if false;
    }

    // Ratings/reviews — public read, one doc per (uid, gameKey), owner-only writes
    match /ratings/{docId} {
      allow read: if true;
      allow create: if isOwner(request.resource.data.uid);
      allow update: if isOwner(resource.data.uid) && isOwner(request.resource.data.uid);
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Monthly club pick — anyone signed in can vote (votes.{uid} = gameKey),
    // tally is computed client-side by aggregating the votes map
    match /picks/{month} {
      allow read: if true;
      // Vote = merge own votes.{uid} field (create allowed when doc missing)
      allow create: if isSignedIn();
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([`votes.${request.auth.uid}`]);
      allow delete: if false;
    }
  }
}
