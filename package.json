{
  "name": "game-vault",
  "version": "1.0.10",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "node scripts/build.js && vite build",
    "build:electron": "node scripts/build.js",
    "build:renderer": "vite build",
    "build:admin": "vite build --config admin-web/vite.config.ts",
    "dev:admin": "vite --config admin-web/vite.config.ts",
    "build:community": "vite build --config community-web/vite.config.ts",
    "dev:community": "vite --config community-web/vite.config.ts",
    "deploy:worker": "npm run build:admin && npm run build:community && npx wrangler deploy",
    "pack:win": "electron-builder --win",
    "postinstall": "node scripts/ensure-config.js",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron --test tests/**/*.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "GameVault - Personal Game Library and Playtime Tracker",
  "dependencies": {
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.11",
    "koffi": "^3.3.8",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "cross-env": "^10.1.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.6"
  },
  "build": {
    "appId": "com.gamevault.app",
    "productName": "GameVault",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!dist-electron/*.map",
      "!dist-electron/cloud-config.json",
      "assets/**/*",
      "package.json",
      "!worker/**",
      "!admin-web/**",
      "!community-web/**",
      "!status-worker/**",
      "!.dev.vars*",
      "!cloud-config.json",
      "!**/*.map",
      "!gamevault.db*",
      "!auth-session.json",
      "!tests/**",
      "!scripts/**",
      "!.agents/**",
      "!.wrangler/**"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis-web",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "GameVault-Setup-${version}.${ext}"
    },
    "nsisWeb": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "GameVault-Web-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "GameVault-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "SonhocCodee",
        "repo": "GameVault",
        "releaseType": "release"
      }
    ]
  }
}
